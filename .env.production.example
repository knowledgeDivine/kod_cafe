# Copy these settings into the host's private .env file (outside public source control).
APP_NAME="K.O.D Café"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kod_cafe
DB_USER=kod_app
DB_PASS=replace-with-a-long-unique-database-password
DB_CHARSET=utf8mb4

# Optional live AI Barista. Keep the key server-side and never expose it to JavaScript.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
